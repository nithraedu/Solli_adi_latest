<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_next2"
    tools:context="nithra.tamil.word.game.solliadi.Odd_man_out">

    <RelativeLayout
        android:id="@+id/head"

        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/time_score_board"
            android:layout_width="match_parent"
            android:layout_height="@dimen/wh_40"
            android:background="@drawable/actionbar_back"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lrtbp_5"
                android:layout_marginBottom="@dimen/lrtbp_5">

                <LinearLayout
                    android:id="@+id/asd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/lrtbp_5"
                    android:layout_marginTop="@dimen/wh_2"
                    android:background="@drawable/time_background">

                    <ImageView
                        android:layout_width="@dimen/txt_25"
                        android:layout_height="@dimen/txt_25"
                        android:background="@drawable/timeicon" />

                    <Chronometer
                        android:id="@+id/s_time_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/lrtbp_5"
                        android:layout_marginRight="@dimen/lrtbp_10"
                        android:textColor="@color/white"
                        android:textSize="@dimen/txt_18" />

                </LinearLayout>


                <RelativeLayout
                    android:id="@+id/adsicon2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toLeftOf="@+id/s_word_number1"
                    android:layout_toRightOf="@+id/asd"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/prize_logo"
                        android:layout_width="@dimen/croll_insbut_height"
                        android:layout_height="@dimen/croll_insbut_height"

                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:src="@drawable/gift"
                        android:visibility="invisible" />

                    <ImageView
                        android:id="@+id/ads_logo2"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/adlogo"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/adbadge"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/earncoin"
                        android:layout_width="@dimen/croll_insbut_height"
                        android:layout_height="@dimen/croll_insbut_height"
                        android:layout_centerInParent="true"
                        android:background="@drawable/cn_earn"
                        android:gravity="center"
                        android:paddingLeft="@dimen/lrtbp_5"
                        android:paddingTop="@dimen/wh_2"
                        android:paddingRight="@dimen/lrtbp_5"
                        android:paddingBottom="@dimen/wh_2"
                        android:textColor="@color/white"
                        android:textSize="@dimen/txt_20"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/s_word_number1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">

                    <TextView
                        android:id="@+id/s_word_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:background="@drawable/time_background"
                        android:paddingLeft="@dimen/lrtbp_5"
                        android:paddingRight="@dimen/lrtbp_5"
                        android:text="no"
                        android:textColor="@color/white"
                        android:textSize="@dimen/txt_20"
                        android:textStyle="bold" />
                </RelativeLayout>


                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/qwt"
                    android:layout_toRightOf="@+id/s_word_number1">

                    <TextView
                        android:id="@+id/s_settings"
                        android:layout_width="@dimen/croll_insbut_height"
                        android:layout_height="@dimen/croll_insbut_height"

                        android:layout_centerInParent="true"
                        android:background="@drawable/settings"
                        android:gravity="center" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/qwt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/wh_2"
                    android:layout_marginRight="@dimen/lrtbp_5"
                    android:background="@drawable/time_background">

                    <ImageView
                        android:layout_width="@dimen/txt_25"
                        android:layout_height="@dimen/txt_25"
                        android:background="@drawable/cons" />

                    <TextView
                        android:id="@+id/s_score_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/lrtbp_5"
                        android:layout_marginRight="@dimen/lrtbp_5"
                        android:paddingRight="@dimen/lrtbp_10"

                        android:text=" SCORE"
                        android:textColor="@color/white"
                        android:textSize="@dimen/txt_18" />
                </LinearLayout>


            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/addtional_req"
            android:layout_width="match_parent"
            android:layout_height="33dp"
            android:layout_marginLeft="@dimen/lrtbp_5"
            android:layout_marginTop="@dimen/lrtbp_30"
            android:layout_marginRight="@dimen/lrtbp_5"
            android:gravity="end"

            android:orientation="horizontal">


            <LinearLayout
                android:id="@+id/skipLayout"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:background="@drawable/skip_background">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text=" Skip"
                    android:textColor="@color/black"
                    android:textSize="@dimen/txt_16"
                    android:textStyle="bold" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_marginLeft="@dimen/lrtbp_10"
                android:layout_marginRight="@dimen/lrtbp_5"
                android:background="@drawable/skip_background"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/txt_22"
                    android:layout_height="@dimen/txt_24"
                    android:background="@drawable/restore"
                    android:backgroundTint="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/lrtbp_5"
                    android:layout_marginRight="@dimen/lrtbp_5"
                    android:gravity="center"

                    android:text=" Reset"
                    android:textColor="@color/black"
                    android:textSize="@dimen/txt_16"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/que"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/addtional_req"
            android:layout_marginLeft="@dimen/lrtbp_25"
            android:layout_marginTop="@dimen/lrtbp_10"
            android:layout_marginRight="@dimen/lrtbp_25"
            android:background="@color/blueicon">

            <TextView
                android:id="@+id/question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/lrtbp_5"
                android:text="Questions"
                android:textColor="@color/white"
                android:textSize="@dimen/txt_18"
                android:textStyle="bold" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/below"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/hint"
            android:layout_below="@+id/que"
            android:layout_marginLeft="@dimen/lrtbp_5"
            android:layout_marginRight="@dimen/lrtbp_5">

            <RelativeLayout
                android:id="@+id/sixcat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:background="@color/light_orange"
                    android:orientation="vertical"
                    android:padding="@dimen/lrtbp_5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/croll_app_height"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/bt1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/curve_opposite_word"
                            android:gravity="center"
                            android:text="gfhfg"
                            android:textColor="@color/white"
                            android:textSize="@dimen/txt_18"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bt2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/lrtbp_5"
                            android:layout_weight="1"
                            android:background="@drawable/curve_opposite_word"
                            android:gravity="center"
                            android:text="gfhfg"
                            android:textColor="@color/white"
                            android:textSize="@dimen/txt_18"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bt3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/lrtbp_5"
                            android:layout_weight="1"
                            android:background="@drawable/curve_opposite_word"
                            android:gravity="center"
                            android:text="gfhfg"
                            android:textColor="@color/white"
                            android:textSize="@dimen/txt_18"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/croll_app_height"
                        android:layout_marginTop="@dimen/lrtbp_5"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/bt4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/curve_opposite_word"
                            android:gravity="center"
                            android:text="gfhfg"
                            android:textColor="@color/white"
                            android:textSize="@dimen/txt_18"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bt5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/lrtbp_5"
                            android:layout_weight="1"
                            android:background="@drawable/curve_opposite_word"
                            android:gravity="center"
                            android:text="gfhfg"
                            android:textColor="@color/white"
                            android:textSize="@dimen/txt_18"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bt6"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/lrtbp_5"
                            android:layout_weight="1"
                            android:background="@drawable/curve_opposite_word"
                            android:gravity="center"
                            android:text="gfhfg"
                            android:textColor="@color/white"
                            android:textSize="@dimen/txt_18"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/fourcat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:background="@color/light_orange"
                    android:orientation="vertical"

                    android:padding="@dimen/lrtbp_5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/croll_app_height"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/bts1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/curve_opposite_word"
                            android:gravity="center"
                            android:text="gfhfg"
                            android:textColor="@color/white"
                            android:textSize="@dimen/txt_18"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bts2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/lrtbp_5"
                            android:layout_weight="1"
                            android:background="@drawable/curve_opposite_word"
                            android:gravity="center"
                            android:text="gfhfg"
                            android:textColor="@color/white"
                            android:textSize="@dimen/txt_18"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/croll_app_height"
                        android:layout_marginTop="@dimen/lrtbp_5"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/bts3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/curve_opposite_word"
                            android:gravity="center"
                            android:text="gfhfg"
                            android:textColor="@color/white"
                            android:textSize="@dimen/txt_18"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bts4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/lrtbp_5"
                            android:layout_weight="1"
                            android:background="@drawable/curve_opposite_word"
                            android:gravity="center"
                            android:text="gfhfg"
                            android:textColor="@color/white"
                            android:textSize="@dimen/txt_18"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>


            </RelativeLayout>

        </RelativeLayout>

        <TextView
            android:id="@+id/discription"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/hint"
            android:layout_below="@+id/below"
            android:layout_marginLeft="@dimen/lrtbp_5"
            android:layout_marginTop="@dimen/lrtbp_5"
            android:layout_marginRight="@dimen/lrtbp_5"
            android:background="@color/cardview_dark_background"
            android:gravity="center"
            android:text="Discription"
            android:textColor="@color/white"
            android:textSize="@dimen/txt_16"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="@dimen/wh_45"
            android:layout_height="@dimen/wh_45"
            android:layout_above="@+id/bottom"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/lrtbp_5"
            android:background="@drawable/fifty_fifty"
            android:textColor="@color/worngans"
            android:textSize="@dimen/txt_20"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/lrtbp_30">

            <LinearLayout
                android:id="@+id/helpshare_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/lrtbp_5"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/p_facebook"
                    android:layout_width="@dimen/wh_35"
                    android:layout_height="@dimen/wh_35"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/lrtbp_10"
                    android:layout_marginRight="@dimen/lrtbp_10"
                    android:background="@drawable/fb" />

                <TextView
                    android:id="@+id/p_watts_app"
                    android:layout_width="@dimen/wh_35"
                    android:layout_height="@dimen/wh_35"
                    android:layout_below="@+id/p_facebook"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/lrtbp_10"
                    android:layout_marginRight="@dimen/lrtbp_10"
                    android:background="@drawable/watsapp" />

                <TextView
                    android:id="@+id/p_gplues"
                    android:layout_width="@dimen/wh_35"
                    android:layout_height="@dimen/wh_35"
                    android:layout_below="@+id/p_watts_app"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/lrtbp_10"
                    android:layout_marginRight="@dimen/lrtbp_5"
                    android:background="@drawable/gplues"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/p_coins"
            android:layout_width="@dimen/wh_35"
            android:layout_height="@dimen/wh_35"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/coin"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/p_coins_red"
            android:layout_width="@dimen/wh_35"
            android:layout_height="@dimen/wh_35"
            android:layout_alignParentRight="true"
            android:layout_marginTop="@dimen/lrtbp_5"
            android:layout_marginRight="@dimen/lrtbp_15"
            android:background="@drawable/coin"
            android:visibility="invisible" />
    </RelativeLayout>


    <LinearLayout
        android:id="@+id/ads_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:visibility="gone" />
</RelativeLayout>
